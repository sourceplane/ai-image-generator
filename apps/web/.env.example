# Workers AI draws with no key: the Worker's AI binding (wrangler.jsonc). In
# `pnpm dev` / `pnpm preview` the binding reaches your Cloudflare account, so
# run `pnpm exec wrangler login` once.
#
# The template's other providers appear once their keys are set. In a deployed
# environment each is an Orun secret of the same name (README → Add a
# provider); never commit them.
OPENAI_API_KEY=
REPLICATE_API_TOKEN=
FIREWORKS_API_KEY=
# Google Vertex AI: a service account's email and private key, the project and
# its region (all four, or Vertex stays off).
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_VERTEX_PROJECT=
GOOGLE_VERTEX_LOCATION=

# Optional. The site's public origin (the Open Graph image's absolute URL);
# the Orun build sets it to the environment's SITE_URL or Worker URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
